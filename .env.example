# Public API 서비스 (api_service 계정 - public_serving/reference 스키마 읽기 전용)
PUBLIC_API_DATABASE_URL=postgresql+psycopg://api_service:CHANGE_ME@localhost:5432/stock_screener

# Public API CORS 허용 오리진(쉼표로 구분, 03-system-design.md §6-3 "자사 프론트엔드
# 오리진으로만 제한"). 값을 지정하지 않으면 로컬 개발 기본값
# http://localhost:3000(services/public_api/core/config.py DEFAULT_CORS_ALLOWED_ORIGINS)이
# 적용된다. 프로덕션 배포 도메인이 확정되면 실제 도메인으로 재정의할 것(호스팅 벤더
# 미확정 - 03-system-design.md §2-1).
# PUBLIC_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Alembic 마이그레이션 (DDL 권한 필요, batch_worker 등 특권 계정)
ALEMBIC_DATABASE_URL=postgresql+psycopg://migrator:CHANGE_ME@localhost:5432/stock_screener

# scripts/load_calendar.py, services/ingestion_batch, services/derivation_batch
# (batch_worker 계정 - reference/raw_internal/public_serving 쓰기 권한).
# UNIT-06부터 Derivation Batch도 이 동일한 환경변수를 사용한다(§1-3, batch_worker
# role 공유 — services/derivation_batch/core/config.py 참조).
BATCH_DATABASE_URL=postgresql+psycopg://batch_worker:CHANGE_ME@localhost:5432/stock_screener

# services/ingestion_batch: 공공데이터포털 "금융위원회_주식시세정보"
# (GetStockSecuritiesInfoService_V2/getStockPriceInfo_V2) 활용신청 후 발급받는
# 서비스키(디코딩 인증키). 실제 키가 발급되기 전까지는 --dry-run으로만
# 실행 가능하다. 2026-09-22 실 키로 정상 응답(resultCode=00) 실측 확인 완료.
GOV_DATA_PORTAL_SERVICE_KEY=CHANGE_ME

# 기본값은 services/ingestion_batch/core/config.py에 이미 있으며, 필요 시에만
# 재정의한다(예: 테스트용 목 서버 지정).
# GOV_DATA_PORTAL_BASE_URL=https://apis.data.go.kr/1160100/GetStockSecuritiesInfoService_V2/getStockPriceInfo_V2

# services/ingestion_batch: DART(전자공시시스템) OpenAPI 인증키(opendart.fss.or.kr,
# 마이페이지 > 오픈API 이용현황에서 확인). 업종분류(기업개황 API)와 PER/PBR 산출용
# 재무제표(재무제표 API) 수집에 사용한다. 개인회원은 신청 즉시 발급된다.
# 2026-09-22 실 키 발급 완료(services/ingestion_batch/gov_data_client.py의
# PER/PBR 미제공 이슈(DEF-005)를 이 소스로 대체하기 위해 도입).
DART_API_KEY=CHANGE_ME

# --- 프론트 서버(SSR) 내부 호출의 방문자 IP 식별 (DEC-045, rate limit) ---
# 프론트 서버와 같은 값을 양쪽에 설정한다(임의의 긴 무작위 문자열). 비어 있으면 기능이 꺼져 TCP peer 기준으로만 센다.
# PUBLIC_API_INTERNAL_TOKEN=
# 토큰은 있으나 방문자 IP를 모르는 내부 호출에 적용하는 공용 버킷 한도(분당, 기본 600)
# PUBLIC_API_INTERNAL_RATE_LIMIT_PER_MINUTE=600

# --- 시세 원값 공개 스위치 (DEC-048 → DEC-050, 기본 켜짐) ---
# 기본은 켜짐(종목 상세 차트·일자별 시세, 목록 시세 표시). 법률 검토(REQ-022) 전 외부 배포 환경에서는 false로 끈다.
# false이면 /stocks/{code}/prices, /stocks/quotes가 404 FEATURE_DISABLED. 프론트의 NEXT_PUBLIC_PRICE_EXPOSURE_ENABLED와 같은 값으로 맞춘다.
# PUBLIC_API_PRICE_EXPOSURE_ENABLED=false

# --- 개인 로컬 모드: 장중 시세(분봉·호가·체결, 한국투자증권 Open API) (DEC-052) ---
# 내 PC에서만 쓰는 개인용 기능이다. 기본 꺼짐. 켜도 허용 IP(기본 127.0.0.1,::1)·사설 Host에서 온 요청에만 응답하고,
# 프록시/터널 헤더(X-Forwarded-For, CF-Connecting-IP 등)가 있으면 거부한다. **외부 공개 배포에서는 반드시 false.**
# 앱키·시크릿은 이 파일(.env, git 제외)에만 둔다. 화면(브라우저)으로는 절대 나가지 않는다.
# LOCAL_INTRADAY_ENABLED=false
# KIS_APP_KEY=
# KIS_APP_SECRET=
# 허용 IP/CIDR(쉼표). 같은 와이파이의 휴대폰에서 볼 때만 늘린다(예: 127.0.0.1,::1,192.168.0.0/24)
# LOCAL_INTRADAY_ALLOWED_IPS=127.0.0.1,::1
# 토큰 캐시 파일(권한 0600, git 제외). 기본 .local/kis_token.json
# KIS_TOKEN_CACHE_PATH=.local/kis_token.json
# 로컬 모드 경로 전용 분당 요청 한도(기본 600)
# LOCAL_INTRADAY_RATE_LIMIT_PER_MINUTE=600
# 모의 서버(scripts/mock_kis_server.py)로 시험할 때만: KIS_BASE_URL=http://127.0.0.1:9100 / KIS_ALLOW_CUSTOM_BASE_URL=true
# 실시간(웹소켓, DEC-084): 기본은 증권사 실전 주소(ws://ops.koreainvestment.com:21000). 모의 웹소켓 서버(scripts/mock_kis_ws_server.py)로 시험할 때만
# KIS_WS_URL=ws://127.0.0.1:9101 (KIS_ALLOW_CUSTOM_BASE_URL=true 필요). 실제 운용에서는 설정하지 않는다. 사용법: docs/ops/local-realtime-guide.md
# KIS_WS_URL=
# 화면이 닫힌 뒤 실시간 구독을 유지하는 시간(초, 선택, 기본 30). 시험할 때만 줄인다.
# KIS_REALTIME_GRACE_SECONDS=30

# --- 선택: 무료 호스팅(Render + Neon) 베타용 (DEC-063, 절차서 docs/ops/render-neon-guide.md) ---
# PUBLIC_API_DB_CONNECT_TIMEOUT_SECONDS=10     # 기본 3 (1~30)
# PUBLIC_API_DB_STATEMENT_TIMEOUT_MS=8000      # 기본 3000 (500~30000)
# PUBLIC_API_REQUEST_TIMEOUT_SECONDS=15        # 기본 4.5 (1~60)
# PUBLIC_API_TRUSTED_PROXY_IPS=                # 프록시 IP/CIDR. 비우면 헤더를 신뢰하지 않음
# PUBLIC_API_REQUIRE_TRUSTED_PROXY=true        # true면 위 값이 비었을 때 서버 시작을 거부
# PUBLIC_API_LOG_PEER_IPS=1                    # 프록시 대역 확인 중에만(방문자 IP가 로그에 남음)
