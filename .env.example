# Public API 서비스 (api_service 계정 - public_serving/reference 스키마 읽기 전용)
PUBLIC_API_DATABASE_URL=postgresql+psycopg://api_service:CHANGE_ME@localhost:5432/stock_screener

# Alembic 마이그레이션 (DDL 권한 필요, batch_worker 등 특권 계정)
ALEMBIC_DATABASE_URL=postgresql+psycopg://migrator:CHANGE_ME@localhost:5432/stock_screener

# scripts/load_calendar.py, services/ingestion_batch, services/derivation_batch
# (batch_worker 계정 - reference/raw_internal/public_serving 쓰기 권한).
# UNIT-06부터 Derivation Batch도 이 동일한 환경변수를 사용한다(§1-3, batch_worker
# role 공유 — services/derivation_batch/core/config.py 참조).
BATCH_DATABASE_URL=postgresql+psycopg://batch_worker:CHANGE_ME@localhost:5432/stock_screener

# services/ingestion_batch: 공공데이터포털 "금융위원회_주식시세정보"
# (GetStockSecuritiesInfoService/getStockPriceInfo) 활용신청 후 발급받는
# 서비스키(디코딩 인증키). 실제 키가 발급되기 전까지는 --dry-run으로만
# 실행 가능하다(unit-02-note.md §2 참조 - 실 키로 검증 못 함).
GOV_DATA_PORTAL_SERVICE_KEY=CHANGE_ME

# 기본값은 services/ingestion_batch/core/config.py에 이미 있으며, 필요 시에만
# 재정의한다(예: 테스트용 목 서버 지정).
# GOV_DATA_PORTAL_BASE_URL=https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService/getStockPriceInfo
