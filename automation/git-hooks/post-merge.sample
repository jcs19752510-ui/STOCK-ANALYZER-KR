#!/bin/sh
# 설치: 이 파일을 프로젝트 루트의 .git/hooks/post-merge 로 복사하고 실행권한을 준다.
#   cp automation/git-hooks/post-merge.sample .git/hooks/post-merge
#   chmod +x .git/hooks/post-merge
#
# work unit 브랜치가 로컬에 병합되면, 곧바로 6단계(단위테스트)를 실제로 실행한다.
# claude CLI 인증(ANTHROPIC_API_KEY 등)이 로컬 환경에도 되어 있어야 동작한다.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ ! -x "automation/run-harness-agent.sh" ]; then
  echo "[harness] automation/run-harness-agent.sh 를 찾을 수 없어 훅을 건너뜁니다."
  exit 0
fi

echo "[harness] post-merge 감지 — 6단계(단위테스트) 실행"
# set -e를 쓰지 않는다: 이 훅은 git 동작 자체를 막으면 안 되므로,
# 스크립트가 실패해도 마지막에 항상 exit 0으로 끝내고 결과만 안내한다.
./automation/run-harness-agent.sh 06-unit-tester \
  "docs/harness/units/ 를 스캔해서 unit-<n>-note.md는 있는데 unit-<n>-test.md가 없거나 FAIL인 단위를 전부 처리하라."
EXIT_CODE=$?

if [ "$EXIT_CODE" -eq 75 ]; then
  echo "[harness] 사람의 판단이 필요합니다. 위 질문을 확인하세요. (커밋 자체는 막지 않습니다)"
elif [ "$EXIT_CODE" -ne 0 ]; then
  echo "[harness] 6단계 테스트 FAIL. docs/harness/units/ 의 최신 테스트 결과서를 확인하세요."
fi

exit 0
