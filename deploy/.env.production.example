# deploy/.env  — production settings for the single-server (Oracle VM) stack.
# Create it with:   ./scripts/init-env.sh      (fills the random secrets for you)
# NEVER commit this file. Keep file mode 600. Values with CHANGE_ME / FILL_ME must be filled by you.

# ---- site address (no https://, no trailing slash) ----
# Example: mystock.duckdns.org   (free sub-domain)  or  stock.example.com  (your own domain)
SITE_HOST=FILL_ME
# Let's Encrypt expiry notices go to this address
ACME_EMAIL=FILL_ME

# ---- database passwords (random; generated by init-env.sh; hex only so URLs stay valid) ----
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
MIGRATOR_PASSWORD=CHANGE_ME
BATCH_WORKER_PASSWORD=CHANGE_ME
API_SERVICE_PASSWORD=CHANGE_ME

# ---- shared secret between frontend server and API (random; generated by init-env.sh) ----
PUBLIC_API_INTERNAL_TOKEN=CHANGE_ME

# ---- external data keys: issue NEW keys (the old ones appeared in screenshots/chat) ----
GOV_DATA_PORTAL_SERVICE_KEY=FILL_ME
DART_API_KEY=FILL_ME
# optional Slack/Discord webhook for "data is stale" alerts
DATA_FRESHNESS_WEBHOOK_URL=

# ---- feature switches (decide with the legal review: docs/ops/pre-deploy-checklist.md A) ----
# false = raw price values (chart, daily prices, quotes) are NOT shown publicly. Safe default.
PRICE_EXPOSURE_ENABLED=false
PATTERN_SCREEN_ENABLED=true

# ---- backups to Cloudflare R2 ----
# age public key (starts with "age1"). The PRIVATE key stays on your own PC only. See the guide.
BACKUP_AGE_RECIPIENT=FILL_ME
R2_BUCKET=FILL_ME
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=FILL_ME
# create an R2 API token limited to this bucket (object read & write)
R2_ACCESS_KEY_ID=FILL_ME
R2_SECRET_ACCESS_KEY=FILL_ME
BACKUP_KEEP_DAILY_DAYS=14
BACKUP_KEEP_WEEKLY_DAYS=60

# ---- NEVER put these here (personal local mode must stay off on a public server) ----
# LOCAL_INTRADAY_ENABLED / KIS_APP_KEY / KIS_APP_SECRET
